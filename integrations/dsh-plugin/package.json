{
  "name": "dsh-plugin-agent-merge",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for auditable session timelines and optional test-gated multi-agent coding orchestration",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-merge",
    "session",
    "version-control",
    "bisect",
    "orchestration",
    "multi-agent",
    "coding-agent"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuanZhengPM/agent-merge.git",
    "directory": "integrations/dsh-plugin"
  },
  "homepage": "https://github.com/GuanZhengPM/agent-merge#readme",
  "bugs": {
    "url": "https://github.com/GuanZhengPM/agent-merge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test tests/*.test.ts",
    "prepack": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "dependencies": {
    "@guanzhengpm/agent-merge": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
