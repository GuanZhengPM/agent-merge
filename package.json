{
  "name": "@guanzhengpm/agent-merge",
  "version": "0.2.0",
  "description": "Harness-neutral multi-agent coding orchestration with Git worktrees, test-gated patch selection, repair rounds, and versioned session timelines.",
  "keywords": [
    "agent",
    "llm",
    "version-control",
    "session",
    "trajectory",
    "context",
    "harness",
    "bisect",
    "orchestration",
    "multi-agent",
    "git-worktree",
    "coding-agent"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuanZhengPM/agent-merge.git"
  },
  "homepage": "https://github.com/GuanZhengPM/agent-merge#readme",
  "bugs": {
    "url": "https://github.com/GuanZhengPM/agent-merge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-merge": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "integrations/skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "prepack": "pnpm run typecheck && pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
